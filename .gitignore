.terraform/
*.tfstate
*.tfstate.*
.crash

# .terraform.lock.hcl is intentionally NOT ignored: committing it pins provider
# versions so local runs and CI resolve identically.
*.tfvars
!important.tfvars.example
.DS_Store

# Generated by scripts/embed_chunks.py. Several megabytes of float arrays, and
# reproducible from the source corpus, so it stays out of the repository.
*.embeddings.jsonl

# Generated by scripts/generate_corpus.py from a fixed seed, so it regenerates
# byte for byte. 19MB of combinatorial filler does not belong in git; the
# hand-written data/arduino-basics.jsonl is the corpus that is committed.
arduino-synthetic.jsonl

.venv/
__pycache__/
*.pyc
